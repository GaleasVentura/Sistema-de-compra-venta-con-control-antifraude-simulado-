@model List<PerfumeriaMVC.Models.Productos>

<h2>Lista de productos</h2>

<table border="1" cellpadding="5">
    <tr>
        <th>ID</th>
        <th>Nombre</th>
        <th>Marca</th>
        <th>Precio</th>
        <th>Stock</th>
        <th>Estado</th>
    </tr>

@foreach (var item in Model)
{
    <tr>
        <td>@item.id_producto</td>
        <td>@item.nombre</td>
        <td>@item.marca</td>
        <td>@item.precio</td>
        <td>@item.stock</td>
        <td>@item.estado</td>
    </tr>
}
</table>