@model List<PerfumeriaMVC.Models.Productos>

@{
    ViewData["Title"] = "Productos Empleado";
}

<div class="container mt-4">

    <h2>📦 Productos (Empleado)</h2>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Marca</th>
                <th>Precio</th>
                <th>Stock</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.id_producto</td>
                    <td>@item.nombre</td>
                    <td>@item.marca</td>
                    <td>$@item.precio</td>
                    <td>@item.stock</td>
                </tr>
            }
        </tbody>
    </table>

</div>