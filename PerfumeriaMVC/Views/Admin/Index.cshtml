@{
    ViewData["Title"] = "Panel Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <h2>⚙️ Panel Administrador</h2>
    <p class="text-muted">Control total del sistema</p>

    <!-- 📊 TARJETAS -->
    <div class="row text-center mt-4">

        <div class="col-md-3">
            <div class="card shadow p-3">
                <h5>🛍️ Productos</h5>
                <h3>@ViewBag.TotalProductos</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow p-3">
                <h5>👥 Usuarios</h5>
                <h3>@ViewBag.TotalUsuarios</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow p-3">
                <h5>💳 Ventas</h5>
                <h3>@ViewBag.TotalVentas</h3>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow p-3 bg-danger text-white">
                <h5>🚨 Sospechosas</h5>
                <h3>@ViewBag.Sospechosas</h3>
            </div>
        </div>

    </div>

    <!-- 🔗 ACCIONES -->
    <div class="row mt-4">

        <div class="col-md-4">
            <a asp-action="Productos" class="btn btn-primary w-100 mb-2">
                🛍️ Gestionar Productos
            </a>
        </div>

        <div class="col-md-4">
            <a asp-action="Usuarios" class="btn btn-warning w-100 mb-2">
                👥 Gestionar Usuarios
            </a>
        </div>

        <div class="col-md-4">
            <a href="/Admin/Transacciones" class="btn btn-danger w-100 mb-2">
                🚨 Ver Transacciones
            </a>
        </div>

    </div>

</div>