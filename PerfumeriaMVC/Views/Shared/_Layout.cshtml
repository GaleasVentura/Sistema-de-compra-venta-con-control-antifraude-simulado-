@{
    var rol = Context.Session.GetString("rol");
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PerfumeriaMVC</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Estilos globales -->
    <link rel="stylesheet" href="~/css/admin.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tienda.css" />


    @RenderSection("Styles", required: false)
</head>

<body>
    <img src="~/Imagenes/Login.png" class="img-fluid" alt="Login imagen"
         style="width:100%; height:400px; object-fit:cover; object-position: top;" />
    <!-- ================= HEADER ================= -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    Perfumería
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- MENÚ -->
                    @{
                        var rol = Context.Session.GetString("rol");
                    }

                    <ul class="navbar-nav">

                        @if (rol == "CLIENTE")
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="/">🏠 Home</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Carrito">🛒 Carrito</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Compras">💳 Compras</a>
                            </li>
                        }

                        @if (rol == "ADMIN")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-danger" href="/Admin/Index">⚙️ Admin</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-warning" href="/Admin/Dashboard">📊 Dashboard</a>
                            </li>
                        }

                        @if (rol == "EMPLEADO")
                        {
                            <li class="nav-item">
                                <a class="nav-link text-success" href="/Empleado/Index">🧑‍💼 Empleado</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Empleado/Productos">🛍️ Productos</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Empleado/Compras">💳 Compras</a>
                            </li>
                        }

                    </ul>

                    <!-- LOGOUT -->
                    <div class="d-flex align-items-center">
                        <a asp-controller="Account" asp-action="Logout" class="logout-circle">
                            ⛔
                        </a>
                    </div>

                </div>
            </div>
        </nav>
    </header>

    <!-- ================= CONTENIDO PRINCIPAL ================= -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- ================= PANEL SOLO CLIENTE (ABAJO) ================= -->
    @if (rol == "CLIENTE")
    {
        <div class="container mt-4 text-center">

            <div class="card shadow-sm p-3">

                <h4>Bienvenido Cliente 👋</h4>

                <img src="~/images/banner-cliente.jpg" class="img-fluid mt-3"
                     style="max-height: 400px; object-fit: cover;" />

                <p class="mt-3">
                    Explora nuestras fragancias exclusivas para ti.
                </p>

            </div>

        </div>
    }

    <!-- ================= FOOTER ================= -->
    <footer class="border-top footer text-muted mt-4">
        <div class="container">
            &copy; 2026 - PerfumeriaMVC
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/tienda.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>